# Copy to .env or pass --env-path to the runner.
# VLM-2 answer generation uses the same config contract as pdf_vlm_symbolic_vlm_baseline.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
ANSWER_PROVIDER={siliconflow,openai_compatible}
ANSWER_API_KEY=
ANSWER_BASE_URL=
ANSWER_MODEL=Qwen/Qwen3-VL-8B-Instruct
ANSWER_TEMPERATURE=0
ANSWER_MAX_TOKENS=4096
ANSWER_TIMEOUT_SECONDS=180
GENERATION_PARSE_MAX_RETRIES=2
GENERATION_RETRY_ON_429={true,false}
GENERATION_429_MAX_RETRIES=6
GENERATION_429_INITIAL_BACKOFF_SECONDS=20
GENERATION_429_BACKOFF_MULTIPLIER=2
GENERATION_429_MAX_BACKOFF_SECONDS=300
GENERATION_COOLDOWN_AFTER_429_SECONDS=120

# Parser-first baseline settings.
LITTRACEQA_TRANSCRIPTION_BACKEND={pymupdf,docling}
DOCLING_DO_OCR={true,false}
VLM2_CONTEXT_MODE={text_only,cropped_image}
VLM2_CONTEXT_SELECTION_MODE={ranked_budget,bm25_budget,record_budget,page_all_symbolic,section_aware,record_only,local_window,section_full,subsection_full,section_relevance}
VLM2_EVIDENCE_TOTAL_BUDGET=24
VLM2_PRIMARY_EVIDENCE_MIN=6
VLM2_SUPPORT_TEXT_MIN=4
VLM2_CONTEXT_TYPES_ENABLED={true,false}
VLM2_CONTEXT_TYPE_BUDGET_PER_TYPE=3
VLM2_MAX_CONTEXT_RECORDS=0
VLM2_MAX_CONTEXT_CHARS=0
SYMBOLIC_EVIDENCE_STANDARDIZATION={true,false}
SYMBOLIC_SOURCE_TYPE_HINTS={true,false}

# Section-level relevance retrieval. SECTION_RELEVANCE_RECORD_TOP_K=0 expands every
# record in each selected section; positive values are a diagnostic cap only.
SECTION_RELEVANCE_BACKEND={bm25,e5_base_v2,hybrid,llmrerank}
SINGLE_PAPER_SECTION_RELEVANCE_TOP_K=5
MULTI_PAPER_SECTION_RELEVANCE_TOP_K=12
SECTION_RELEVANCE_CHUNK_MAX_TOKENS=448
SECTION_RELEVANCE_CHUNK_OVERLAP_TOKENS=0
SECTION_RELEVANCE_TEXT_MAX_CHARS=6000
SECTION_RELEVANCE_RECORD_TOP_K=0
# record_aware is the default retrieval granularity. The UNIT_* settings below
# control it; SECTION_RELEVANCE_CHUNK_* remains available for legacy backends.
SECTION_RELEVANCE_UNIT_MODE={token_chunks,record_aware}
SECTION_RELEVANCE_UNIT_TARGET_TOKENS=1280
SECTION_RELEVANCE_UNIT_MAX_TOKENS=1536
SECTION_RELEVANCE_UNIT_OVERLAP_RECORDS=1
SECTION_RELEVANCE_OBJECT_UNITS_ENABLED={true,false}
SECTION_RELEVANCE_OBJECT_NEIGHBOR_RECORDS=1
SECTION_RELEVANCE_AGGREGATION_TOP_K=3
SECTION_RELEVANCE_SECTION_BONUS_WEIGHT=0.10
SECTION_RELEVANCE_OBJECT_SECTION_BONUS_WEIGHT=0.15
SECTION_RELEVANCE_SECTION_BONUS_MAX=0.10
SINGLE_PAPER_RETRIEVAL_UNIT_TOP_K=12
MULTI_PAPER_RETRIEVAL_UNIT_TOP_K=36
SECTION_RELEVANCE_HYBRID_BM25_WEIGHT=0.4
SECTION_RELEVANCE_HYBRID_E5_WEIGHT=0.6
SECTION_RELEVANCE_E5_MODEL=intfloat/e5-base-v2
SECTION_RELEVANCE_POOLING={log_mean_exp,mean,max}
SECTION_RELEVANCE_LOG_MEAN_EXP_LAMBDA=3
SECTION_RELEVANCE_QUERY_SECTION_BONUS_ENABLED={true,false}
SECTION_RELEVANCE_QUERY_SECTION_BONUS=0.2
SECTION_RELEVANCE_PRIMARY_TYPE_PRIOR_ENABLED={true,false}
SECTION_RELEVANCE_PRIMARY_TYPE_PRIOR_MAX_BONUS=0.05

# Pointwise Qwen retrieval-unit reranking through the provider's /rerank endpoint.
LLMRERANK_MODEL=Qwen/Qwen3-VL-Reranker-8B
LLMRERANK_INPUT_MODE={text_only,text_with_object_images}
LLMRERANK_BATCH_SIZE=8
LLMRERANK_REQUEST_CONCURRENCY=1
LLMRERANK_REQUEST_TIMEOUT_SECONDS=120
LLMRERANK_MAX_RETRIES=3
LLMRERANK_FAILURE_FALLBACK={none,bm25,e5_base_v2,hybrid}
# Legacy token_chunks mode only; record_aware uses SECTION_RELEVANCE_UNIT_*.
LLMRERANK_SECTION_CHUNK_MAX_TOKENS=6144
LLMRERANK_SECTION_CHUNK_OVERLAP_TOKENS=128
LLMRERANK_SECTION_POOLING={max,log_mean_exp,top_k_mean}
LLMRERANK_LOG_MEAN_EXP_LAMBDA=5
LLMRERANK_TOP_K_MEAN_CHUNKS=3
LLMRERANK_CONTEXT_TOP_K_CHUNKS=3
LLMRERANK_MAX_IMAGES_PER_SECTION=4
LLMRERANK_INSTRUCTION_VERSION={v1,v2}
# Disabled by default: the quality baseline scores every canonical logical unit with Qwen.
# Enable only for an evaluated sparse candidate-union experiment with full-Qwen fallback.
LLMRERANK_UNIT_PREFILTER_ENABLED={true,false}
LLMRERANK_UNIT_PREFILTER_TOP_K=64
LLMRERANK_UNIT_PREFILTER_PER_SECTION=3
LLMRERANK_UNIT_PREFILTER_PRIMARY_TOP_K=32
LLMRERANK_PREFILTER_FALLBACK_WEIGHT=0.25
# Safe only when the query names exactly one candidate paper by full title or paper_id
# and names an exact object label. Disabled otherwise and disabled by default.
LLMRERANK_DETERMINISTIC_LOCATOR_ONLY_ENABLED={true,false}
SECTION_RELEVANCE_APPLY_SECTION_TYPE_BONUS={true,false}

# Experimental multi-paper-only HyDE fusion. Disabled by default; final section
# budget remains MULTI_PAPER_SECTION_RELEVANCE_TOP_K.
MULTI_PAPER_HYDE_ENABLED={true,false}
MULTI_PAPER_HYDE_MODEL=deepseek-ai/DeepSeek-V4-Flash
MULTI_PAPER_HYDE_ORIGINAL_WEIGHT=0.7
MULTI_PAPER_HYDE_CLAIM_WEIGHT=0.3
MULTI_PAPER_HYDE_MAX_CLAIMS=4
MULTI_PAPER_HYDE_CACHE_ENABLED={true,false}
MULTI_PAPER_HYDE_TEMPERATURE=0
MULTI_PAPER_HYDE_MAX_TOKENS=512
MULTI_PAPER_HYDE_TIMEOUT_SECONDS=120
MULTI_PAPER_HYDE_UNIT_MAX_TOKENS=448
MULTI_PAPER_HYDE_TOP_HITS_PER_CLAIM=20

# Metadata/PDF retrieval settings.
RETRIEVAL_METHOD={hybrid_alias,bm25_simple}
RETRIEVAL_ENABLE_TOPIC_EXPANSION={true,false}
RETRIEVAL_ENABLE_QUERY_DECOMPOSITION={true,false}
RETRIEVAL_SUBQUERY_TOP_K=4
TASK_FAMILY_BUDGET_ENABLED={true,false}
SINGLE_PAPER_TOP_K_PAPERS=5
MULTI_PAPER_TOP_K_PAPERS=12
PDF_OPENREVIEW_POLICY={proceedings_first_skip_direct_openreview,proceedings_first_allow_direct_openreview,allow_direct_openreview}
