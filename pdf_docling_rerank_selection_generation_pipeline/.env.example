# Copy to .env or pass --env-path to the runner.
# VLM-2 answer generation uses the same config contract as pdf_vlm_symbolic_vlm_baseline.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
ANSWER_PROVIDER={siliconflow,openai_compatible}
ANSWER_API_KEY=
ANSWER_BASE_URL=
ANSWER_MODEL=Qwen/Qwen3-VL-8B-Instruct
ANSWER_TEMPERATURE=0
ANSWER_MAX_TOKENS=4096
ANSWER_TIMEOUT_SECONDS=180
GENERATION_PARSE_MAX_RETRIES=2
GENERATION_REQUEST_RETRIES=1
GENERATION_RETRY_ON_429={true,false}
GENERATION_429_MAX_RETRIES=6
GENERATION_429_INITIAL_BACKOFF_SECONDS=20
GENERATION_429_BACKOFF_MULTIPLIER=2
GENERATION_429_MAX_BACKOFF_SECONDS=300
GENERATION_COOLDOWN_AFTER_429_SECONDS=120

# Query-aware L0-L3 evidence hierarchy. The hierarchy reads frozen selected L0
# records and never accesses gold answers/evidence. verified_llm cards must pass
# an extractive support-quote gate; invalid cards fall back to extractive cards.
EVIDENCE_HIERARCHY_CARD_MODE={extractive,verified_llm}
EVIDENCE_HIERARCHY_MAX_CLAIMS=6
EVIDENCE_HIERARCHY_MAX_CARDS=24
EVIDENCE_HIERARCHY_L1_MAX_CHARS=420
EVIDENCE_HIERARCHY_L3_PAPER_CHARS=360
EVIDENCE_HIERARCHY_CARD_MAX_TOKENS=4096
EVIDENCE_HIERARCHY_CARD_SOURCE_CHARS=85000
EVIDENCE_HIERARCHY_VERIFICATION_MODE={extractive}
EVIDENCE_HIERARCHY_MAX_IMAGES=8
# Bounded RECOMP-style extractive safety net. These are short L2 propositions
# with a support_ref, not ungrounded summaries and not a Qwen prefilter.
EVIDENCE_HIERARCHY_MICRO_INDEX_CHARS=26000
EVIDENCE_HIERARCHY_MICRO_TEXT_CHARS=240
# Keyed L2 removes raw locators and uses a compact navigation index, leaving
# more prompt budget for short text propositions.
# 0: no intermediate cap; final --max-prompt-chars remains the hard budget.
EVIDENCE_HIERARCHY_KEYED_MICRO_INDEX_CHARS=0
EVIDENCE_HIERARCHY_KEYED_MICRO_TEXT_CHARS=180
# selection: preserve frozen selector order; query_aware: retain all anchors
# but order compact L2 propositions by lexical query alignment;
# stability_query_aware: prioritize anchors selected by multiple frozen paths,
# then apply query alignment.
EVIDENCE_HIERARCHY_KEYED_MICRO_ORDER={selection,query_aware,stability_query_aware}
# Second pass: expand only model-selected C-keys to their raw L0/L1 evidence
# for factual verification and answer repair. This never reranks the corpus.
EVIDENCE_HIERARCHY_POSTHOC_REFINEMENT_ENABLED={true,false}
# Optional figure-only L2 enrichment. Each card is produced from a selected
# Docling crop and independently verified against the same crop before it can
# support a generated answer. It is separate from, and never reruns, Qwen
# reranking. Keep it disabled until its smoke evaluation is accepted.
EVIDENCE_HIERARCHY_VISUAL_CARDS_ENABLED={true,false}
EVIDENCE_HIERARCHY_VISUAL_CARDS_MAX_PER_QUERY=8
EVIDENCE_HIERARCHY_VISUAL_CARDS_MAX_PER_PAPER=1
EVIDENCE_HIERARCHY_VISUAL_CARDS_MAX_TOKENS=320
EVIDENCE_HIERARCHY_VISUAL_VERIFY_MAX_TOKENS=120

# CIRAG-inspired contextual triples. Text/structured windows are batch-processed
# once per query; figure crops are isolated and processed only when available.
EVIDENCE_TRIPLE_MODE={extractive,verified_llm}
EVIDENCE_TRIPLE_TEXT_MODEL=Qwen/Qwen3-VL-8B-Instruct
EVIDENCE_TRIPLE_VISUAL_MODEL=Qwen/Qwen3-VL-8B-Instruct
EVIDENCE_TRIPLE_SOURCE_CHARS=30000
EVIDENCE_TRIPLE_BATCH_SOURCE_CHARS=5000
EVIDENCE_TRIPLE_TEXT_MAX_TOKENS=512
EVIDENCE_TRIPLE_TEXT_MAX_WINDOWS=8
EVIDENCE_TRIPLE_TIMEOUT_SECONDS=45
EVIDENCE_TRIPLE_CACHE_ENABLED={true,false}
EVIDENCE_TRIPLE_VISUAL_MAX_TOKENS=320
EVIDENCE_TRIPLE_VISUAL_MAX_PER_QUERY=4
EVIDENCE_TRIPLE_SUFFICIENCY_ENABLED={true,false}
EVIDENCE_TRIPLE_SUFFICIENCY_MODEL=Qwen/Qwen3-VL-8B-Instruct
EVIDENCE_TRIPLE_SUFFICIENCY_MAX_TOKENS=320

# Parser-first baseline settings.
LITTRACEQA_TRANSCRIPTION_BACKEND={pymupdf,docling}
DOCLING_DO_OCR={true,false}
VLM2_CONTEXT_MODE={text_only,cropped_image}
VLM2_CONTEXT_SELECTION_MODE={section_relevance}
# Packages, not bare chunks, are the generation unit. 80,000 characters is
# approximately a 20k-token evidence ceiling before the answer prompt.
SINGLE_PAPER_EVIDENCE_PACKAGE_BUDGET=12
MULTI_PAPER_EVIDENCE_PACKAGE_BUDGET=36
SINGLE_PAPER_EVIDENCE_PACKAGE_MIN=4
MULTI_PAPER_EVIDENCE_PACKAGE_MIN=4
MULTI_PAPER_MIN_DISTINCT_PAPERS=4
EVIDENCE_PACKAGE_ADAPTIVE_STOP={true,false}
MULTI_PAPER_MODALITY_PACKAGES_PER_PAPER=2
MULTI_PAPER_SUPPORTING_TEXT_PACKAGES_PER_PAPER=0
# Positive: cap selected context chars; 0: inherit generation default; -1: unbounded audit mode.
EVIDENCE_PACKAGE_MAX_CONTEXT_CHARS=80000
EVIDENCE_PACKAGE_RRF_K=60
# 0 means keep the complete union from every route for full-Qwen quality mode.
EVIDENCE_PACKAGE_CANDIDATE_POOL_PER_ROUTE=0
EVIDENCE_PACKAGE_MAX_PER_PAGE=2
EVIDENCE_PACKAGE_PAGE_TEXT_ANCHORS_PER_PAGE=0
SYMBOLIC_EVIDENCE_STANDARDIZATION={true,false}
SYMBOLIC_SOURCE_TYPE_HINTS={true,false}

# Record-aware Qwen/BM25 scoring. Final selection is package coverage, not
# section Top-K, so no section or chunk budget is exposed here.
SECTION_RELEVANCE_BACKEND={bm25,llmrerank}
RETRIEVER_POOL_BUDGET=0  # 0=disabled (full-Qwen iron-rule default); >0 builds a hybrid retriever pool (special objects preserved) that bounds the Qwen reranking input
SECTION_RELEVANCE_UNIT_MODE={record_aware}
SECTION_RELEVANCE_UNIT_TARGET_TOKENS=1280
SECTION_RELEVANCE_UNIT_MAX_TOKENS=1536
SECTION_RELEVANCE_UNIT_OVERLAP_RECORDS=1
SECTION_RELEVANCE_OBJECT_UNITS_ENABLED={true,false}
SECTION_RELEVANCE_OBJECT_NEIGHBOR_RECORDS=1

# Pointwise Qwen retrieval-unit reranking through the provider's /rerank endpoint.
LLMRERANK_MODEL=Qwen/Qwen3-VL-Reranker-8B
LLMRERANK_INPUT_MODE={text_only,text_with_object_images}
LLMRERANK_BATCH_SIZE=8
LLMRERANK_REQUEST_CONCURRENCY=1
LLMRERANK_REQUEST_TIMEOUT_SECONDS=120
LLMRERANK_MAX_RETRIES=3
LLMRERANK_FAILURE_FALLBACK={none,bm25}
LLMRERANK_MAX_IMAGES_PER_SECTION=4
LLMRERANK_INSTRUCTION_VERSION={v1,v2,v3_complete_support,v4_complete_support_minimal}
LLMRERANK_QUERY_MODE={original,mask_method_aliases}
LLMRERANK_INCLUDE_PAPER_IDENTITY={true,false}

# Optional multi-paper HyDE adds lexical routing claims. It never changes Qwen
# scores or applies score fusion.
MULTI_PAPER_HYDE_ENABLED={true,false}
MULTI_PAPER_HYDE_MODEL=deepseek-ai/DeepSeek-V4-Flash
MULTI_PAPER_HYDE_MAX_CLAIMS=4
MULTI_PAPER_HYDE_CACHE_ENABLED={true,false}
MULTI_PAPER_HYDE_TEMPERATURE=0
MULTI_PAPER_HYDE_MAX_TOKENS=512
MULTI_PAPER_HYDE_TIMEOUT_SECONDS=120

# Optional candidate-paper-specific lexical routes for indirect comparison evidence.
PAPER_CONDITIONED_CLAIMS_ENABLED={true,false}
PAPER_CONDITIONED_CLAIMS_MODEL=deepseek-ai/DeepSeek-V4-Flash
PAPER_CONDITIONED_CLAIMS_MAX_PAPERS=12
PAPER_CONDITIONED_CLAIMS_CACHE_ENABLED={true,false}
PAPER_CONDITIONED_CLAIMS_TEMPERATURE=0
PAPER_CONDITIONED_CLAIMS_MAX_TOKENS=1800
PAPER_CONDITIONED_CLAIMS_TIMEOUT_SECONDS=120
PAPER_LOCAL_BM25_ROUTE_MODE={disabled,original,mask_method_aliases}

# Metadata/PDF retrieval settings.
RETRIEVAL_METHOD={hybrid_alias,bm25_simple}
RETRIEVAL_ENABLE_QUERY_DECOMPOSITION={true,false}
RETRIEVAL_SUBQUERY_TOP_K=4
TASK_FAMILY_BUDGET_ENABLED={true,false}
SINGLE_PAPER_TOP_K_PAPERS=5
MULTI_PAPER_TOP_K_PAPERS=12
PDF_OPENREVIEW_POLICY={proceedings_first_skip_direct_openreview,proceedings_first_allow_direct_openreview,allow_direct_openreview}
