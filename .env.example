# Shared SiliconFlow credentials and metadata-only baseline defaults
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3-VL-8B-Instruct
SILICONFLOW_TEMPERATURE=0
SILICONFLOW_MAX_TOKENS=3000
SILICONFLOW_TIMEOUT_SECONDS=120


# Legacy OCR baseline
OCR_PROVIDER=siliconflow
OCR_API_KEY=
OCR_BASE_URL=
OCR_MODEL=deepseek-ai/DeepSeek-OCR
OCR_DEVICE=auto
OCR_MAX_PAGES_PER_PAPER=0


# VLM-1 symbolic page parser
PARSER_PROVIDER=siliconflow
PARSER_API_KEY=
PARSER_BASE_URL=
PARSER_MODEL=Qwen/Qwen3-VL-8B-Instruct
PARSER_TEMPERATURE=0
PARSER_MAX_TOKENS=8192
PARSER_TIMEOUT_SECONDS=180
PARSER_EXTRACTION_MODE=text_first_symbolic_transcription
PARSER_MAX_RECORDS_PER_CALL=8
PARSER_MAX_CONTINUATIONS_PER_PAGE=6
PARSER_REQUIRE_COMPLETENESS=false
PARSER_ALLOW_PARTIAL_PAGE=true
PARSER_RETRY_ON_JSON_FAILURE=1
PARSER_RETRY_ON_SCHEMA_FAILURE=1
PARSER_ALLOW_REGION_SPLIT=false
PARSER_REGION_SPLIT_ON_REPEATED_FAILURE=false


# VLM-2 answer generation
ANSWER_PROVIDER=siliconflow
ANSWER_API_KEY=
ANSWER_BASE_URL=
ANSWER_MODEL=Qwen/Qwen3-VL-8B-Instruct
ANSWER_TEMPERATURE=0
ANSWER_MAX_TOKENS=4096
ANSWER_TIMEOUT_SECONDS=180


# Retrieval and PDF source policy
RETRIEVAL_METHOD=hybrid_alias
RETRIEVAL_ENABLE_TOPIC_EXPANSION=false
RETRIEVAL_ENABLE_QUERY_DECOMPOSITION=true
RETRIEVAL_SUBQUERY_TOP_K=4
TASK_FAMILY_BUDGET_ENABLED=true
SINGLE_PAPER_TOP_K_PAPERS=5
SINGLE_PAPER_PAGE_ROUTING_TOP_PAGES_PER_CANDIDATE=5
MULTI_PAPER_TOP_K_PAPERS=12
MULTI_PAPER_PAGE_ROUTING_TOP_PAGES_PER_CANDIDATE=3
PDF_OPENREVIEW_POLICY=proceedings_first_skip_direct_openreview


# PDF rendering and native text page-routing input
PDF_RENDER_DPI=160
PDF_RENDER_FORMAT=jpg
PDF_RENDER_MAX_PAGES_PER_PAPER=0
PDF_NATIVE_TEXT_CACHE_ENABLED=true
PDF_NATIVE_TEXT_EXTRACTION_METHOD=pymupdf_text
PDF_NATIVE_TEXT_MIN_CHARS_PER_PAGE=40


# Query-level global page routing
PAGE_ROUTING_ENABLED=true
PAGE_ROUTING_SOURCE=native_text
PAGE_ROUTING_METHOD=global_native_text_bm25_rules
PAGE_ROUTING_TOP_PAGES_PER_CANDIDATE=5
PAGE_ROUTING_TOP_PAGES_GLOBAL=
PAGE_ROUTING_MAX_PAGES_GLOBAL=16
PAGE_ROUTING_PARSE_BATCH_SIZE=16
PAGE_ROUTING_ENABLE_PROGRESSIVE_EXPANSION=true
PAGE_ROUTING_EXPANSION_STEP_GLOBAL=4
PAGE_ROUTING_FALLBACK_ON_EMPTY_TEXT=true
PAGE_ROUTING_EMPTY_TEXT_GLOBAL_PARSE_FIRST_N_PAGES=4
PAGE_ROUTING_MIN_SELECTED_RECORDS=8
PAGE_ROUTING_REQUIRE_PRIMARY_TYPE_MATCH=true


# Symbolic artifact cache compatibility
SYMBOLIC_ARTIFACT_VERSION=v5_eval_grounded_minimal_symbolic
STRUCTURED_CACHE_POLICY=reuse_complete_only


# VLM-2 context projection
VLM2_CONTEXT_MODE=text_only
VLM2_INCLUDE_PARSE_CONFIDENCE=false
VLM2_EVIDENCE_TOTAL_BUDGET=24
VLM2_PRIMARY_EVIDENCE_MIN=6
VLM2_SUPPORT_TEXT_MIN=4
VLM2_CONTEXT_TYPES_ENABLED=true
VLM2_CONTEXT_TYPE_BUDGET_PER_TYPE=3
