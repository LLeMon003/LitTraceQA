# Existing SiliconFlow-compatible generation config
SILICONFLOW_API_KEY=PUT_YOUR_NEW_KEY_HERE
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1


# OCR model
OCR_MODEL=deepseek-ai/DeepSeek-OCR
OCR_PROVIDER=siliconflow
# Leave empty to reuse SILICONFLOW_API_KEY.
OCR_API_KEY=
# Leave empty to reuse SILICONFLOW_BASE_URL.
OCR_BASE_URL=

# Multimodal answer generation model.
# This baseline does not require a separate embedding model; OCR chunks are selected directly.
ANSWER_PROVIDER=siliconflow
# Leave empty to reuse SILICONFLOW_API_KEY.
ANSWER_API_KEY=
# Leave empty to reuse SILICONFLOW_BASE_URL.
ANSWER_BASE_URL=
ANSWER_MODEL=Qwen/Qwen3-VL-8B-Instruct
# ANSWER_TEMPERATURE=0
# ANSWER_MAX_TOKENS=3000
# ANSWER_TIMEOUT_SECONDS=120
